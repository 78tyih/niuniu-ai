{
 "gap": 0.34,
 "scenes": {
  "S0": {
   "scene": "s0",
   "vo": 7.3,
   "lines": [
    {
     "id": "S0-1",
     "text": "这是牛牛 AI，装在你自己电脑上的 MT5 交易副驾驶。",
     "start": 0.0,
     "end": 3.36
    },
    {
     "id": "S0-2",
     "text": "两分钟，带你跑通从连接到下单的完整流程。",
     "start": 3.7,
     "end": 7.3
    }
   ]
  },
  "S1": {
   "scene": "s1",
   "vo": 5.14,
   "lines": [
    {
     "id": "S1-1",
     "text": "第一步，点「终端与EA」。",
     "start": 0.0,
     "end": 2.0
    },
    {
     "id": "S1-2",
     "text": "再点「安装桥接EA」，密钥自动写进MT5。",
     "start": 2.34,
     "end": 5.14
    }
   ]
  },
  "S2": {
   "scene": "s2",
   "vo": 7.3,
   "lines": [
    {
     "id": "S2-1",
     "text": "最后一步要手动：把牛牛桥接EA，拖到任意一张图表上。",
     "start": 0.0,
     "end": 3.92
    },
    {
     "id": "S2-2",
     "text": "勾选允许算法交易，把InpAutoTrade改成true。",
     "start": 4.26,
     "end": 7.3
    }
   ]
  },
  "S3": {
   "scene": "s3",
   "vo": 3.76,
   "lines": [
    {
     "id": "S3-1",
     "text": "回到概览页，余额和行情都有数字，就说明连上了。",
     "start": 0.0,
     "end": 3.76
    }
   ]
  },
  "S4": {
   "scene": "s4",
   "vo": 6.58,
   "lines": [
    {
     "id": "S4-1",
     "text": "人工下单，点「交易」页，填好方向和手数。",
     "start": 0.0,
     "end": 3.36
    },
    {
     "id": "S4-2",
     "text": "点「确认下单」，回执显示已成交，才算数。",
     "start": 3.7,
     "end": 6.58
    }
   ]
  },
  "S5": {
   "scene": "s5",
   "vo": 5.94,
   "lines": [
    {
     "id": "S5-1",
     "text": "也可以让AI帮你，点「生成示例建议」。",
     "start": 0.0,
     "end": 2.72
    },
    {
     "id": "S5-2",
     "text": "方向、点位、止损，一张卡片看全。",
     "start": 3.06,
     "end": 5.94
    }
   ]
  },
  "S6": {
   "scene": "s6",
   "vo": 6.34,
   "lines": [
    {
     "id": "S6-1",
     "text": "点「一键下单」，二次确认后，命令才会交给EA。",
     "start": 0.0,
     "end": 3.12
    },
    {
     "id": "S6-2",
     "text": "手数由系统按风险计算，AI不碰数字。",
     "start": 3.46,
     "end": 6.34
    }
   ]
  },
  "S7": {
   "scene": "s7",
   "vo": 8.66,
   "lines": [
    {
     "id": "S7-1",
     "text": "记住三件事：止损必带，下单必二次确认，结果以MT5为准。",
     "start": 0.0,
     "end": 4.48
    },
    {
     "id": "S7-2",
     "text": "现在，去策略广场挑一个模板，跑起你的第一笔模拟单吧。",
     "start": 4.82,
     "end": 8.66
    }
   ]
  }
 }
}